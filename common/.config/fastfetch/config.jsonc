{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 1,
      "right": 2
    }
  },

  "display": {
    "separator": " 󰁔 "
  },

  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue" 
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "cyan" 
    },
    {
      "type": "uptime",
      "key": "󰥔 Uptime",
      "keyColor": "green" 
    },
    {
      "type": "packages",
      "key": "󰏖 Pacman",
      "keyColor": "yellow" 
    },
    {
      "type": "command",
      "key": "󰏖 AUR",
      "keyColor": "magenta",
      "text": "pacman -Qm | wc -l"
    },
    {
      "type": "wm",
      "key": " Window Manager",
      "keyColor": "red" 
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "blue" 
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "green"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
